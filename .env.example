# TekMeet Environment Configuration Template (Placeholders only - Do NOT commit secrets)

# Microsoft Entra ID (Azure AD) App Registration Credentials
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Microsoft Graph Configuration
# Default scope for application client credentials flow
MICROSOFT_GRAPH_SCOPES=https://graph.microsoft.com/.default
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Target Calendar / Bot Mailbox (User Principal Name or email)
# Required when querying calendar with application permissions
AZURE_BOT_USER_EMAIL=

# Phase 2: Azure Bot Service identity and callback configuration
# AZURE_BOT_APP_ID: The Bot's App ID (usually same as AZURE_CLIENT_ID)
AZURE_BOT_APP_ID=
# Display name the bot uses in the Teams participant list
AZURE_BOT_DISPLAY_NAME=TekMeet Notetaker
# Callback URL registered in Azure Bot Service (used by Graph Calling API)
BOT_CALLBACK_URL=https://placeholder.example.com/api/messages

# Calendar Polling & Scheduling Settings
MEETING_LOOKAHEAD_MINUTES=1440
POLL_INTERVAL_SECONDS=60
JOIN_BUFFER_SECONDS=60
AUTO_START_SCHEDULER=false

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Anthropic Claude LLM Summarization Settings
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Phase 4: Deepgram Speech-to-Text Settings
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2


